<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.olegshirko.anvil</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@REPO_ROOT@/scripts/anvil-service.sh</string>
        <string>start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- No KeepAlive: launchd would supervise the anvil-service.sh wrapper,
         which nohup's the daemon and always exits 0 — SuccessfulExit=false
         can never trigger, it only fakes protection. VM crash recovery lives
         inside the daemon (guestDidStop / vsock-unreachable restart). -->
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>@HOME_DIR@/.anvil-vz/launchagent.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME_DIR@/.anvil-vz/launchagent.log</string>
</dict>
</plist>
