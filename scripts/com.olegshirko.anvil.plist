<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.olegshirko.anvil</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@REPO_ROOT@/scripts/anvil-service.sh</string>
        <string>run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- `run` keeps the daemon in the foreground as the job's own process,
         so launchd supervises it: a daemon that crashes (non-zero exit or
         a signal) is started again; `anvil-service.sh stop` / SIGTERM end
         it with exit 0 and it stays stopped. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- The docker-context setup runs beside the daemon and may outlive a
         short-lived job. -->
    <key>AbandonProcessGroup</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@HOME_DIR@/.anvil-vz/launchagent.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME_DIR@/.anvil-vz/launchagent.log</string>
</dict>
</plist>
